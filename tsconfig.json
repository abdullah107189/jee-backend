{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",

    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",

    "rootDir": ".",
    "outDir": "./dist",

    "declaration": true,
    "sourceMap": true
  },

  "include": ["src/**/*.ts", "lib/**/*.ts", "prisma/generated/**/*.ts"],

  "exclude": ["node_modules", "dist"]
}
