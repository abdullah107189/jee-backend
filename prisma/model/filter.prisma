
model Filter {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   @default("MULTI_SELECT")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  options       FilterOption[]
  categoryLinks CategoryFilter[]

  @@index([slug])
  @@map("filters")
}

model FilterOption {
  id        String   @id @default(cuid())
  filterId  String
  value     String
  createdAt DateTime @default(now())

  filter Filter @relation(fields: [filterId], references: [id])

  @@unique([filterId, value])
  @@index([filterId])
  @@map("filter_options")
}

model CategoryFilter {
  id         String @id @default(cuid())
  categoryId String
  filterId   String
  order      Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id])
  filter   Filter   @relation(fields: [filterId], references: [id])

  @@unique([categoryId, filterId])
  @@index([categoryId])
  @@index([filterId])
  @@map("category_filters")
}