// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============= ENUMS =============
enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  DISABLED
}

enum ProductItemStatus {
  AVAILABLE
  SOLD
  RESERVED
  DAMAGED
  RETURNED
  UNDER_REPAIR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
  CLAIMED
  TRANSFERRED
}

enum SaleType {
  ONLINE
  OFFLINE
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ClaimType {
  REPAIR
  REPLACEMENT
  REFUND
}

enum NotificationType {
  ORDER
  WARRANTY
  SALE
  SYSTEM
  PROMOTION
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ============= USER MODELS =============
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  password     String
  firstName    String
  lastName     String
  role         UserRole  @default(CUSTOMER)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  admin        Admin?
  seller       Seller?
  customer     Customer?
  notifications Notification[]
  auditLogs    AuditLog[]
  activityLogs ActivityLog[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  permissions Json?    // Store permissions array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@map("admins")
}

model Seller {
  id              String        @id @default(cuid())
  userId          String        @unique
  companyName     String
  businessLicense String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String
  taxId           String?
  status          SellerStatus  @default(PENDING)
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  offlineSales    OfflineSale[]
  warranties      Warranty[]

  @@index([status])
  @@index([companyName])
  @@map("sellers")
}

model Customer {
  id               String   @id @default(cuid())
  userId           String   @unique
  shippingAddress  Json?    // Store address object
  billingAddress   Json?
  preferredPayment Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
  onlineOrders     OnlineOrder[]
  offlineSales     OfflineSale[]
  warranties       Warranty[]

  @@map("customers")
}

// ============= PRODUCT MODELS =============
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  parentId    String?
  level       Int       @default(0)
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")
  products    Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String?
  specifications   Json?     // JSON for technical specs
  price            Float
  comparePrice     Float?
  cost             Float?
  discount         Float?
  discountType     String?   // PERCENTAGE, FIXED
  sku              String?
  warrantyMonths   Int       @default(12)
  warrantyTerms    String?
  stockQuantity    Int       @default(0)
  lowStockThreshold Int     @default(5)
  images           Json?     // Array of image URLs
  attributes       Json?     // Product attributes
  isPublished      Boolean   @default(false)
  isActive         Boolean   @default(true)
  categoryId       String?
  brandId          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  category         Category? @relation(fields: [categoryId], references: [id])
  brand            Brand?    @relation(fields: [brandId], references: [id])
  productItems     ProductItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([price])
  @@index([deletedAt])
  @@map("products")
}

model ProductItem {
  id                String            @id @default(cuid())
  productId         String
  uniqueId          String            @unique  // Manual unique ID from admin
  serialNumber      String?
  status            ProductItemStatus @default(AVAILABLE)
  metadata          Json?             // Additional item-specific data
  manufacturedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  product           Product           @relation(fields: [productId], references: [id])
  offlineSale       OfflineSale?      @relation("OfflineSaleProductItem")
  onlineOrderItem   OnlineOrderItem?  @relation("OnlineOrderItemProductItem")
  warranty          Warranty?         @relation("WarrantyProductItem")

  @@unique([productId, uniqueId])
  @@index([uniqueId])
  @@index([status])
  @@index([productId])
  @@index([deletedAt])
  @@map("product_items")
}

// ============= SALES MODELS =============
model OnlineOrder {
  id               String            @id @default(cuid())
  customerId       String
  orderNumber      String            @unique
  subtotal         Float
  discount         Float             @default(0)
  tax              Float             @default(0)
  shipping         Float             @default(0)
  total            Float
  status           OrderStatus       @default(PENDING)
  paymentStatus    PaymentStatus     @default(PENDING)
  shippingAddress  Json?             // Address object
  billingAddress   Json?
  trackingNumber   String?
  metadata         Json?
  orderedAt        DateTime          @default(now())
  deliveredAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  customer         Customer          @relation(fields: [customerId], references: [id])
  orderItems       OnlineOrderItem[]
  payments         Payment[]
  warranties       Warranty[]

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("online_orders")
}

model OnlineOrderItem {
  id              String      @id @default(cuid())
  orderId         String
  productItemId   String      @unique  // One ProductItem per order item
  price           Float       // Snapshot at time of purchase
  discount        Float       @default(0)
  tax             Float       @default(0)
  total           Float
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order           OnlineOrder @relation(fields: [orderId], references: [id])
  productItem     ProductItem @relation("OnlineOrderItemProductItem", fields: [productItemId], references: [id])

  @@index([orderId])
  @@index([productItemId])
  @@map("online_order_items")
}

model OfflineSale {
  id              String          @id @default(cuid())
  productItemId   String          @unique
  sellerId        String
  customerId      String?         // Optional, if customer is registered
  customerName    String          // Required for offline sales
  customerPhone   String
  customerEmail   String?
  salePrice       Float
  discount        Float           @default(0)
  tax             Float           @default(0)
  total           Float
  notes           String?
  invoiceNumber   String?         @unique
  paymentMethod   String?         // CASH, CARD, MOBILE, BANK
  paymentStatus   PaymentStatus   @default(PAID)
  saleDate        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  productItem     ProductItem     @relation("OfflineSaleProductItem", fields: [productItemId], references: [id])
  seller          Seller          @relation(fields: [sellerId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  payments        Payment[]

  @@index([productItemId])
  @@index([sellerId])
  @@index([customerId])
  @@index([saleDate])
  @@index([invoiceNumber])
  @@map("offline_sales")
}

// ============= WARRANTY MODELS =============
model Warranty {
  id               String          @id @default(cuid())
  productItemId    String          @unique
  customerId       String?
  sellerId         String?
  orderId          String?
  saleType         SaleType
  startDate        DateTime        @default(now())
  endDate          DateTime
  status           WarrantyStatus  @default(ACTIVE)
  durationMonths   Int
  terms            String?
  coverageDetails  Json?
  claimedAt        DateTime?
  claimReason      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  productItem      ProductItem     @relation("WarrantyProductItem", fields: [productItemId], references: [id])
  customer         Customer?       @relation(fields: [customerId], references: [id])
  seller           Seller?         @relation(fields: [sellerId], references: [id])
  order            OnlineOrder?    @relation(fields: [orderId], references: [id])
  claims           WarrantyClaim[]

  @@index([productItemId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([endDate])
  @@map("warranties")
}

model WarrantyClaim {
  id              String        @id @default(cuid())
  warrantyId      String
  claimNumber     String        @unique
  type            ClaimType
  description     String
  status          ClaimStatus   @default(SUBMITTED)
  resolution      String?
  claimAmount     Float?
  submittedAt     DateTime      @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  warranty        Warranty      @relation(fields: [warrantyId], references: [id])

  @@index([warrantyId])
  @@index([claimNumber])
  @@index([status])
  @@map("warranty_claims")
}

// ============= PAYMENT MODELS =============
model Payment {
  id              String          @id @default(cuid())
  orderId         String?
  offlineSaleId   String?
  amount          Float
  method          String          // CARD, CASH, MOBILE, BANK
  status          PaymentStatus   @default(PENDING)
  transactionId   String?         @unique
  gateway         String?
  gatewayResponse Json?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order           OnlineOrder?    @relation(fields: [orderId], references: [id])
  offlineSale     OfflineSale?    @relation(fields: [offlineSaleId], references: [id])

  @@index([orderId])
  @@index([offlineSaleId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

// ============= NOTIFICATION MODELS =============
model Notification {
  id          String              @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  data        Json?               // Additional data
  channel     NotificationChannel @default(IN_APP)
  isRead      Boolean             @default(false)
  priority    String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  sentAt      DateTime            @default(now())
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============= AUDIT MODELS =============
model AuditLog {
  id          String          @id @default(cuid())
  userId      String
  action      String          // CREATE, UPDATE, DELETE, SALE, etc.
  entity      String          // Product, ProductItem, Sale, etc.
  entityId    String
  changes     Json?           // Before/After JSON
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  severity    AuditSeverity   @default(INFO)
  createdAt   DateTime        @default(now())

  user        User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  activity    String
  description String?
  data        Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}