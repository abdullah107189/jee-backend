model OnlineOrder {
    id              String        @id @default(cuid())
    customerId      String
    orderNumber     String        @unique
    subtotal        Decimal       @db.Decimal(10, 2)
    discount        Decimal       @default(0) @db.Decimal(10, 2)
    tax             Decimal       @default(0) @db.Decimal(10, 2)
    shipping        Decimal       @default(0) @db.Decimal(10, 2)
    total           Decimal       @db.Decimal(10, 2)
    status          OrderStatus   @default(PENDING)
    paymentStatus   PaymentStatus @default(PENDING)
    shippingAddress Json? // Address object
    billingAddress  Json?
    trackingNumber  String?
    metadata        Json?
    orderedAt       DateTime      @default(now())
    deliveredAt     DateTime?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    customer   Customer          @relation(fields: [customerId], references: [id])
    orderItems OnlineOrderItem[]
    payments   Payment[]
    warranties Warranty[]

    @@index([customerId])
    @@index([orderNumber])
    @@index([status])
    @@index([paymentStatus])
    @@index([createdAt])
    @@map("online_orders")
}

model OnlineOrderItem {
    id            String   @id @default(cuid())
    orderId       String
    productItemId String   @unique
    price         Decimal  @db.Decimal(10, 2) // Snapshot at time of purchase
    discount      Decimal  @default(0) @db.Decimal(10, 2)
    tax           Decimal  @default(0) @db.Decimal(10, 2)
    total         Decimal  @db.Decimal(10, 2)
    metadata      Json?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    order       OnlineOrder @relation(fields: [orderId], references: [id])
    productItem ProductItem @relation("OnlineOrderItemProductItem", fields: [productItemId], references: [id])

    @@index([orderId])
    @@index([productItemId])
    @@map("online_order_items")
}

model OfflineSale {
    id            String        @id @default(cuid())
    productItemId String        @unique
    sellerId      String
    customerId    String? // Optional, if customer is registered
    customerName  String // Required for offline sales
    customerPhone String
    customerEmail String?
    salePrice     Decimal       @db.Decimal(10, 2)
    discount      Decimal       @default(0) @db.Decimal(10, 2)
    tax           Decimal       @default(0) @db.Decimal(10, 2)
    total         Decimal       @db.Decimal(10, 2)
    notes         String?
    invoiceNumber String?       @unique
    paymentMethod String? // CASH, CARD, MOBILE, BANK
    paymentStatus PaymentStatus @default(PAID)
    saleDate      DateTime      @default(now())
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    productItem ProductItem @relation("OfflineSaleProductItem", fields: [productItemId], references: [id])
    seller      Seller      @relation(fields: [sellerId], references: [id])

    payments Payment[]
    warranty Warranty?
    customer Customer? @relation(fields: [customerId], references: [id])

    @@index([productItemId])
    @@index([sellerId])
    @@index([customerId])
    @@index([saleDate])
    @@index([invoiceNumber])
    @@map("offline_sales")
}
