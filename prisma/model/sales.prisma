model OnlineOrder {
    id String @id @default(cuid())

    customerId String

    orderNumber String @unique

    subtotal Decimal @db.Decimal(12, 2)
    discount Decimal @default(0) @db.Decimal(12, 2)
    tax      Decimal @default(0) @db.Decimal(12, 2)
    shipping Decimal @default(0) @db.Decimal(12, 2)
    total    Decimal @db.Decimal(12, 2)

    paymentWay    PaymentWay         @default(COD)
    paymentStatus OrderPaymentStatus @default(UNPAID)

    status OrderStatus @default(PENDING)

    shippingAddress Json?

    notes String?

    trackingNumber String?

    metadata Json?

    orderedAt   DateTime  @default(now())
    deliveredAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    customer Customer @relation(fields: [customerId], references: [id])

    orderItems OnlineOrderItem[]

    payments Payment[]

    warranties Warranty[]

    @@index([customerId])
    @@index([status])
    @@index([paymentStatus])
    @@index([paymentWay])
    @@index([createdAt])
    @@map("online_orders")
}

model OnlineOrderItem {
    id String @id @default(cuid())

    orderId String

    variantId     String
    productItemId String @unique

    price    Decimal @db.Decimal(12, 2)
    discount Decimal @default(0) @db.Decimal(12, 2)
    tax      Decimal @default(0) @db.Decimal(12, 2)
    total    Decimal @db.Decimal(12, 2)

    metadata Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    order OnlineOrder @relation(fields: [orderId], references: [id])

    productItem ProductItem @relation("OnlineOrderItemProductItem", fields: [productItemId], references: [id])

    @@index([orderId])
    @@index([variantId])
    @@index([productItemId])
    @@map("online_order_items")
}

model OfflineSale {
    id String @id @default(cuid())

    productItemId String @unique

    sellerId String

    saleDate DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    productItem ProductItem @relation("OfflineSaleProductItem", fields: [productItemId], references: [id])

    seller     Seller    @relation(fields: [sellerId], references: [id])
    customer   Customer? @relation(fields: [customerId], references: [id])
    customerId String?

    @@index([productItemId])
    @@index([sellerId])
    @@index([saleDate])
    @@map("offline_sales")
}
